DB_HOST=localhost
DB_DATABASE=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="Example Company"
MAIL_BCC_ADDRESS=
MAIL_BCC_NAME=

WHATSG_API_KEY=your_whatsg_api_key
WHATSG_TOKEN=
WHATSG_TEMPLATES_JSON='{"Shipment Schedule":{"name":"shipment_schedule","variables":["applicant_name","product_name","document_bill_no","departure_date","arrival_date"],"supportsMedia":false},"Shipment Schedule (Media)":{"name":"shipment_schedule_media","variables":["applicant_name","product_name","document_bill_no","departure_date","arrival_date"],"supportsMedia":true}}'
WHATSG_DEBUG_PAYLOAD=0
WHATSG_MEDIA_BASE_URL=https://example.com/2018

; supportsMedia=true allows the first task image attachment to be sent as mediaUri.
; WHATSG_MEDIA_BASE_URL must be publicly accessible to the WhatsApp provider.
